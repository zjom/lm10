// Session menu: lm10 < examples/session.jsonc
//
// Each entry needs a command; everything else is optional.
//   command  an array of argv strings, or a string split like a shell line
//   name     shown and matched against; defaults to the command line
//   icon     icon name or path; defaults to the command's basename,
//            and null or "" means none
//   run      "print" (the default) prints the command line to stdout,
//            "exec" replaces lm10 with it, "detach" runs it in the background
//
// The same objects also work one per line (JSONL), e.g. from a script:
//   echo '{"name": "foot", "run": "detach", "command": "foot"}' | lm10
[
  { "name": "Lock", "icon": "system-lock-screen", "run": "detach",
    "command": "loginctl lock-session" },
  // commands aren't run by a shell; use sh -c for variables and the like
  { "name": "Log out", "icon": "system-log-out", "run": "detach",
    "command": ["sh", "-c", "loginctl terminate-session \"$XDG_SESSION_ID\""] },
  { "name": "Suspend", "icon": "system-suspend", "run": "detach",
    "command": ["systemctl", "suspend"] },
  { "name": "Hibernate", "icon": "system-hibernate", "run": "detach",
    "command": ["systemctl", "hibernate"] },
  { "name": "Reboot", "icon": "system-reboot", "run": "detach",
    "command": ["systemctl", "reboot"] },
  // quoting in a string command works as on a line: 'a b' is one argument
  { "name": "Reboot into firmware setup", "icon": "system-reboot", "run": "detach",
    "command": "systemctl reboot --firmware-setup" },
  { "name": "Power off", "icon": "system-shutdown", "run": "detach",
    "command": ["systemctl", "poweroff"] },
]
